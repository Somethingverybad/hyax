# Блок для /home/vpn/web/nginx.conf на crystal, внутрь server { server_name milf.hyax.ru; … }
# (добавляет владелец под root; контейнер retro-cloud — в сети vpn-network, доступен по имени).
# Проверка после правки: docker exec vpn-web nginx -t && docker exec vpn-web nginx -s reload
        location /retro-cloud/ {
            resolver 127.0.0.11 valid=30s;
            set $retro_cloud retro-cloud:8099;
            rewrite ^/retro-cloud/(.*)$ /$1 break;
            proxy_pass http://$retro_cloud;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }
